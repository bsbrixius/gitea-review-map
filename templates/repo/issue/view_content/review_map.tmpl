{{if .ReviewMapData}}
{{if .ReviewMapData.IgnoredReason}}
<div class="tw-text-grey">{{ctx.Locale.Tr "review_map.block_ignored" .ReviewMapData.IgnoredReason}}</div>
{{else}}
<div id="review-map-panel" data-issue-link="{{.Issue.Link}}" class="ui segment tw-flex tw-flex-col tw-gap-2">
	<div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1">
		<div class="tw-font-semibold">{{ctx.Locale.Tr "review_map.panel_title"}}</div>
		{{if and (eq .ReviewMapData.InvalidRefCount 0) (eq .ReviewMapData.OrphanCount 0)}}
			<span class="ui small label tw-bg-green tw-text-white">{{svg "octicon-check" 16}} {{ctx.Locale.Tr "review_map.verified"}}</span>
		{{else}}
			{{if gt .ReviewMapData.InvalidRefCount 0}}
				<span class="ui small label tw-bg-red tw-text-white">{{svg "octicon-alert" 16}} {{ctx.Locale.Tr "review_map.invalid_refs" .ReviewMapData.InvalidRefCount}}</span>
			{{end}}
			{{if gt .ReviewMapData.OrphanCount 0}}
				<span class="ui small label">{{svg "octicon-alert" 16}} {{ctx.Locale.Tr "review_map.orphan_refs" .ReviewMapData.OrphanCount}}</span>
			{{end}}
		{{end}}
	</div>
	<div class="tw-text-grey">{{ctx.Locale.Tr "review_map.coverage_label" (printf "%d" .ReviewMapUnmappedChanged) (printf "%d" .ReviewMapData.Coverage.TotalChanged)}}</div>
	{{if .ReviewMapData.Progress}}
		<div class="tw-flex tw-flex-wrap tw-gap-1">
			{{range .ReviewMapData.Progress}}
				<span class="ui small label">{{.Name}} {{ctx.Locale.Tr "review_map.progress_label" .Done .Total}}</span>
			{{end}}
		</div>
	{{end}}
	{{if .ReviewMapData.Coverage.UnmappedFiles}}
		<div class="tw-flex tw-flex-col tw-gap-1">
			<div class="tw-text-grey">{{ctx.Locale.Tr "review_map.unmapped_files"}}</div>
			<div class="tw-flex tw-flex-wrap tw-gap-1">
				{{range .ReviewMapData.Coverage.UnmappedFiles}}
					<span class="ui small label tw-bg-grey">{{.}}</span>
				{{end}}
			</div>
		</div>
	{{end}}
	{{if .ReviewMapData.IgnoreGlobs}}
		<div class="tw-flex tw-flex-col tw-gap-1">
			<div class="tw-text-grey">{{ctx.Locale.Tr "review_map.ignored_globs"}}</div>
			<div class="tw-flex tw-flex-wrap tw-gap-1">
				{{range .ReviewMapData.IgnoreGlobs}}
					<span class="ui small label">{{.}}</span>
				{{end}}
			</div>
		</div>
	{{end}}
	<div class="review-map-bullets tw-flex tw-flex-col tw-gap-2">
		{{range .ReviewMapData.Bullets}}
			<div class="review-map-bullet" data-bullet-index="{{.Index}}" data-bullet-hash="{{.Hash}}">
				{{if $.ReviewMapData.CanReview}}
					<input type="checkbox" class="review-map-check" aria-label="{{ctx.Locale.Tr "review_map.reviewed_label"}}" title="{{ctx.Locale.Tr "review_map.reviewed_label"}}"{{if index $.ReviewMapMyReviewed .Hash}} checked{{end}}>
				{{end}}
				<div class="tw-min-w-0 tw-flex tw-flex-col tw-gap-1">
					<div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1">
						<span class="review-map-bullet-text">{{.Text}}</span>
						{{if .Orphan}}<span class="tw-text-error" title="{{ctx.Locale.Tr "review_map.orphan_warning"}}">{{svg "octicon-alert" 12}}</span>{{end}}
					</div>
					<div class="tw-flex tw-flex-wrap tw-gap-1">
						{{range .Refs}}
							<a class="review-map-ref{{if not .Valid}} tw-text-error{{end}}" href="{{$.Issue.Link}}/files" data-ref-file="{{.File}}" data-ref-start="{{.StartLine}}" data-ref-end="{{.EndLine}}" data-name-hash="{{.NameHash}}">{{.File}}:{{.StartLine}}-{{.EndLine}}{{if not .Valid}} {{svg "octicon-alert" 12}}{{end}}</a>
						{{end}}
						{{range index $.ReviewMapData.CommentLinks .Hash}}
							<a class="review-map-comment" href="{{.URL}}">#</a>
						{{end}}
					</div>
				</div>
			</div>
		{{end}}
	</div>
	<button id="review-map-show-all" type="button" class="tw-hidden">{{ctx.Locale.Tr "review_map.show_all_files"}}</button>
	<div id="review-map-fallback" class="tw-hidden">{{ctx.Locale.Tr "review_map.filter_unavailable"}}</div>
</div>
{{end}}
{{end}}