{{if .ReviewMapData}}
{{if .ReviewMapData.IgnoredReason}}
<div class="tw-text-grey">{{ctx.Locale.Tr "review_map.block_ignored" .ReviewMapData.IgnoredReason}}</div>
{{else}}
<div class="tw-flex tw-flex-wrap tw-items-center tw-gap-2">
	{{template "repo/issue/view_content/review_map_summary".}}
	<a class="ui mini button tw-ml-auto" href="{{.Issue.Link}}/review-map">{{svg "octicon-tasklist" 14}} {{ctx.Locale.Tr "review_map.open_tab"}}</a>
</div>
{{end}}
{{end}}
