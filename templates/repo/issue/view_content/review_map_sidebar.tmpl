{{if .ReviewMapData}}
{{if not .ReviewMapData.IgnoredReason}}
<div id="review-map-panel" data-issue-link="{{.Issue.Link}}" class="review-map-sidebar">
	<div class="review-map-sidebar-header">
		<div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1">
			<div class="tw-font-semibold">{{ctx.Locale.Tr "review_map.panel_title"}}</div>
			<button id="review-map-hide" type="button" class="btn interact-fg tw-ml-auto" title="{{ctx.Locale.Tr "review_map.hide_panel"}}" aria-label="{{ctx.Locale.Tr "review_map.hide_panel"}}">{{svg "octicon-chevron-left" 14}}</button>
			{{if and (eq .ReviewMapData.InvalidRefCount 0) (eq .ReviewMapData.OrphanCount 0)}}
				<span class="ui small label tw-bg-green tw-text-white">{{svg "octicon-check" 12}} {{ctx.Locale.Tr "review_map.verified"}}</span>
			{{else}}
				{{if gt .ReviewMapData.InvalidRefCount 0}}
					<span class="ui small label tw-bg-red tw-text-white">{{svg "octicon-alert" 12}} {{ctx.Locale.Tr "review_map.invalid_refs" .ReviewMapData.InvalidRefCount}}</span>
				{{end}}
				{{if gt .ReviewMapData.OrphanCount 0}}
					<span class="ui small label">{{svg "octicon-alert" 12}} {{ctx.Locale.Tr "review_map.orphan_refs" .ReviewMapData.OrphanCount}}</span>
				{{end}}
			{{end}}
		</div>
		<div class="tw-text-12 tw-text-grey">{{ctx.Locale.Tr "review_map.coverage_label" (printf "%d" .ReviewMapUnmappedChanged) (printf "%d" .ReviewMapData.Coverage.TotalChanged)}}</div>
		{{if .ReviewMapData.Progress}}
			<div class="tw-flex tw-flex-wrap tw-gap-1">
				{{range .ReviewMapData.Progress}}
					<span class="ui small label">{{.Name}} {{ctx.Locale.Tr "review_map.progress_label" .Done .Total}}</span>
				{{end}}
			</div>
		{{end}}
		<button id="review-map-show-all" type="button" class="ui tiny button tw-hidden">{{ctx.Locale.Tr "review_map.show_all_files"}}</button>
	</div>
	<div class="review-map-bullets tw-flex tw-flex-col tw-gap-2">
		{{range .ReviewMapData.Bullets}}
			{{$bullet := .}}
			{{$approval := index $.ReviewMapData.BulletApproval .Index}}
			<div class="review-map-bullet" data-bullet-index="{{.Index}}" data-bullet-hash="{{.Hash}}">
				<div class="tw-flex tw-items-start tw-gap-2">
					<span class="review-map-bullet-no" aria-hidden="true"></span>
					<div class="tw-min-w-0 tw-flex tw-flex-col tw-gap-1">
						<div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1">
							<span class="review-map-bullet-text" title="{{.Text}}">{{.Text}}</span>
							{{if .Orphan}}<span class="tw-text-error" title="{{ctx.Locale.Tr "review_map.orphan_warning"}}">{{svg "octicon-alert" 12}}</span>{{end}}
						</div>
						<div class="tw-flex tw-flex-wrap tw-items-center tw-gap-2 tw-text-12">
							<span class="review-map-bullet-stats tw-flex tw-gap-1">
								<span class="tw-text-green">+{{.AddedLines}}</span>
								<span class="tw-text-red">−{{.RemovedLines}}</span>
								<span class="tw-text-grey">{{ctx.Locale.Tr "review_map.bullet_files" (len .Refs)}}</span>
							</span>
							{{if and $.ReviewMapData.CanReview $approval}}
								<button type="button" class="review-map-approve-chip ui mini label{{if and (gt $approval.Total 0) (eq $approval.Approved $approval.Total)}} review-map-done tw-bg-green tw-text-white{{end}}" data-approved="{{$approval.Approved}}" data-total="{{$approval.Total}}" title="{{ctx.Locale.Tr "review_map.approve_all_tooltip"}}"><span class="review-map-chip-count">{{$approval.Approved}}/{{$approval.Total}}</span> {{ctx.Locale.Tr "review_map.approved_label"}}</button>
							{{end}}
						</div>
						<div class="tw-flex tw-flex-col review-map-refs">
							{{range $i, $ref := .Refs}}
								<span class="tw-flex tw-items-center tw-gap-1">
									{{if and $.ReviewMapData.CanReview $ref.Valid}}
										<input type="checkbox" class="review-map-ref-check" data-ref-index="{{$i}}" aria-label="{{ctx.Locale.Tr "review_map.approve_ref_label" $ref.File}}" title="{{ctx.Locale.Tr "review_map.approve_ref_label" $ref.File}}"{{if index $.ReviewMapMyApprovedRefs (printf "%s:i%d" $bullet.Hash $i)}} checked{{end}}>
									{{end}}
									<a class="review-map-ref{{if not $ref.Valid}} tw-text-error{{end}}" href="{{$.Issue.Link}}/files" data-ref-file="{{$ref.File}}" data-ref-start="{{$ref.StartLine}}" data-ref-end="{{$ref.EndLine}}" data-name-hash="{{$ref.NameHash}}">{{$ref.File}}:{{$ref.StartLine}}-{{$ref.EndLine}}{{if not $ref.Valid}} {{svg "octicon-alert" 12}}{{end}}</a>
								</span>
							{{end}}
							{{range index $.ReviewMapData.CommentLinks .Hash}}
								<a class="review-map-comment" href="{{.URL}}">#</a>
							{{end}}
						</div>
					</div>
				</div>
			</div>
		{{end}}
	</div>
	<span id="review-map-filtered-stats-tpl" class="tw-hidden" data-tpl="{{ctx.Locale.Tr "review_map.filtered_stats" "{n}" "{total}"}}"></span>
	<span id="review-map-approve-change-tpl" class="tw-hidden" data-label="{{ctx.Locale.Tr "review_map.approve_change"}}" data-tooltip="{{ctx.Locale.Tr "review_map.approve_change_tooltip"}}"></span>
	{{if or .ReviewMapData.Coverage.UnmappedFiles .ReviewMapData.IgnoreGlobs}}
		<div class="review-map-sidebar-footer tw-flex tw-flex-col tw-gap-1 tw-text-12">
			{{if .ReviewMapData.Coverage.UnmappedFiles}}
				<details>
					<summary class="tw-text-grey">{{ctx.Locale.Tr "review_map.unmapped_files"}} ({{len .ReviewMapData.Coverage.UnmappedFiles}})</summary>
					<div class="tw-flex tw-flex-wrap tw-gap-1">
						{{range .ReviewMapData.Coverage.UnmappedFiles}}
							<span class="ui small label tw-bg-grey">{{.}}</span>
						{{end}}
					</div>
				</details>
			{{end}}
			{{if .ReviewMapData.IgnoreGlobs}}
				<details>
					<summary class="tw-text-grey">{{ctx.Locale.Tr "review_map.ignored_globs"}}</summary>
					<div class="tw-flex tw-flex-wrap tw-gap-1">
						{{range .ReviewMapData.IgnoreGlobs}}
							<span class="ui small label">{{.}}</span>
						{{end}}
					</div>
				</details>
			{{end}}
		</div>
	{{end}}
	<div id="review-map-fallback" class="tw-hidden">{{ctx.Locale.Tr "review_map.filter_unavailable"}}</div>
</div>
{{end}}
{{end}}
